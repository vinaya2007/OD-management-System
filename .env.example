# Public Supabase project settings. Use the project URL, not a key, for NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Server-only. Keep this unset locally unless a reviewed provisioning job needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used by OAuth callback redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication. Demo mode is deliberately disabled by default.
ALLOWED_EMAIL_DOMAIN=srmist.edu.in
ENABLE_DEMO_AUTH=false

# Email. Leave unset to retain in-app notifications without email delivery.
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=

# College identity shown in generated documents and application metadata.
COLLEGE_NAME= SRM Institute of Science and Technology, Vadapalani Campus
COLLEGE_DEPARTMENT= Electronics and Communication Engineering