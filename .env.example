# Public Supabase project settings. These are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Use only for administrative provisioning tasks, never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used by OAuth callback redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication. Demo mode is deliberately disabled by default.
ALLOWED_EMAIL_DOMAIN=srms.edu.in
ENABLE_DEMO_AUTH=false

# Email. Leave unset to retain in-app notifications without email delivery.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# College identity shown in generated documents and application metadata.
COLLEGE_NAME=
COLLEGE_DEPARTMENT=
